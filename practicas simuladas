import datetime
from abc import ABC, abstractmethod

# ==========================================
# 1. SISTEMA DE LOGS Y ARCHIVO
# ==========================================
class LogManager:
    """Clase encargada de registrar todos los eventos y errores del sistema en un archivo de log."""
    LOG_FILE = "sistema.log"

    @classmethod
    def registrar(cls, nivel: str, mensaje: str):
        timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        log_entry = f"[{timestamp}] [{nivel.upper()}] {mensaje}\n"
        try:
            with open(cls.LOG_FILE, "a", encoding="utf-8") as f:
                f.write(log_entry)
        except Exception as e:
            print(f"Error crítico al escribir en el log: {e}")


# ==========================================
# 2. EXCEPCIONES PERSONALIZADAS
# ==========================================
class SoftwareFJException(Exception):
    """Excepción base para los errores del sistema de Software FJ."""
 pass

class ClienteNoEncontradoException(SoftwareFJException):
    def __init__(self, mensaje="El cliente especificado no está registrado o sus datos son inválidos."):
        super().__init__(mensaje)

class ServicioNoDisponibleException(SoftwareFJException):
    def __init__(self, mensaje="El servicio solicitado no se encuentra disponible actualmente."):
        super().__init__(mensaje)

class ReservaInvalidaException(SoftwareFJException):
    def __init__(self, mensaje="Los datos de la reserva contienen inconsistencias o parámetros inválidos."):
        super().__init__(mensaje)


# ==========================================
# 3. CLASES Y JERARQUÍA ORIENTADA A OBJETOS
# ==========================================
class EntidadBase(ABC):
    """Clase abstracta general del sistema."""
    def __init__(self, id_entidad: str):
        self._id_entidad = id_entidad

    @property
def id_entidad(self):
        return self._id_entidad

class Cliente(EntidadBase):
    def __init__(self, id_entidad: str, nombre: str, email: str, telefono: str):
        super().__init__(id_entidad)
        self.nombre = nombre
        self.email = email
        self.telefono = telefono

class Servicio(ABC):
    """Clase abstracta Servicio para implementar polimorfismo."""
    def __init__(self, codigo: str, nombre: str, costo_base: float):
        self.codigo = codigo
        self.nombre = nombre
        self.costo_base = costo_base

    @abstractmethod
    def calcular_costo(self, *args, **kwargs) -> float:
        pass

# Servicios especializados (Herencia y Polimorfismo)
class ReservaSalas(Servicio):
    def calcular_costo(self, horas: int, impuesto: float = 0.19) -> float:
        return (self.costo_base * horas) * (1 + impuesto)

class AlquilerEquipos(Servicio):
    def calcular_costo(self, dias: int, descuento: float = 0.0) -> float:
        total = (self.costo_base * dias) - descuento
        return max(0.0, total)

class AsesoriaEspecializada(Servicio):
    def calcular_costo(self, sesiones: int) -> float:
        return self.costo_base * sesiones


# ==========================================
# 4. GESTIÓN DE RESERVAS Y LÓGICA DE NEGOCIO
# ==========================================
class Reserva:
    def __init__(self, id_reserva: str, cliente: Cliente, servicio: Servicio, duracion: int):
        self.id_reserva = id_reserva
        self.cliente = cliente
        self.servicio = servicio
        self.duracion = duracion
        self.estado = "Activa"
        self.costo_total = 0.0

    def procesar_reserva(self):
        if isinstance(self.servicio, ReservaSalas):
            self.costo_total = self.servicio.calcular_costo(horas=self.duracion)
        elif isinstance(self.servicio, AlquilerEquipos):
            self.costo_total = self.servicio.calcular_costo(dias=self.duracion)
        elif isinstance(self.servicio, AsesoriaEspecializada):
            self.costo_total = self.servicio.calcular_costo(sesiones=self.duracion)
        else:
            raise ReservaInvalidaException("Tipo de servicio desconocido para procesar la reserva.")

class SistemaGestion:
    def __init__(self):
        self.clientes = []
        self.servicios = []
        self.reservas = []

    def registrar_cliente(self, id_entidad, nombre, email, telefono):
        if not id_entidad or not nombre or not email:
            LogManager.registrar("ERROR", f"Intento fallido de registrar cliente con datos incompletos: ID={id_entidad}")
            raise ClienteNoEncontradoException("Los datos del cliente no pueden estar vacíos.")
        
        for c in self.clientes:
            if c.id_entidad == id_entidad:
                LogManager.registrar("ADVERTENCIA", f"Cliente duplicado detectado: ID {id_entidad}")
                raise ClienteNoEncontradoException(f"El cliente con ID {id_entidad} ya existe.")

        nuevo_cliente = Cliente(id_entidad, nombre, email, telefono)
        self.clientes.append(nuevo_cliente)
        LogManager.registrar("INFO", f"Cliente registrado exitosamente: {nombre} (ID: {id_entidad})")
        print(f"-> [Éxito] Cliente {nombre} registrado correctamente.")

    def registrar_servicio(self, servicio: Servicio):
        self.servicios.append(servicio)
        LogManager.registrar("INFO", f"Servicio registrado: {servicio.nombre} (Código: {servicio.codigo})")

    def crear_reserva(self, id_reserva, id_cliente, codigo_servicio, duracion):
        try:
            # Buscar cliente
            cliente_encontrado = next((c for c in self.clientes if c.id_entidad == id_cliente), None)
            if not cliente_encontrado:
                raise ClienteNoEncontradoException(f"No se encontró el cliente con ID {id_cliente}.")

            # Buscar servicio
            servicio_encontrado = next((s for s in self.servicios if s.codigo == codigo_servicio), None)
            if not servicio_encontrado:
                raise ServicioNoDisponibleException(f"El servicio con código {codigo_servicio} no está disponible.")

            # Validar duración estricta
            if duracion <= 0:
                raise ReservaInvalidaException("La duración de la reserva debe ser mayor a cero.")

            # Crear y procesar reserva
reserva = Reserva(id_reserva, cliente_encontrado, servicio_encontrado, duracion)
            reserva.procesar_reserva()
            self.reservas.append(reserva)
            
            LogManager.registrar("INFO", f"Reserva {id_reserva} creada con éxito para {cliente_encontrado.nombre}. Total: ${reserva.costo_total:.2f}")
            print(f"-> [Éxito] Reserva {id_reserva} procesada. Costo Total: ${reserva.costo_total:.2f}")

        except SoftwareFJException as e:
            LogManager.registrar("ERROR", f"Fallo al crear reserva {id_reserva}: {str(e)}")
            print(f"-> [Error de Negocio Controlado] {e}")
        except Exception as e:
            LogManager.registrar("CRITICO", f"Error inesperado en reserva {id_reserva}: {str(e)}")
            print(f"-> [Error Inesperado] {e}")


