import datetime
from abc import ABC, abstractmethod

# ==========================================
# 1. SISTEMA DE LOGS Y ARCHIVO
# ==========================================
class LogManager:
    """Clase encargada de registrar todos los eventos y errores del sistema en un archivo de log."""
    LOG_FILE = "sistema.log"

    @classmethod
    def registrar(cls, nivel: str, mensaje: str):
        timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        log_entry = f"[{timestamp}] [{nivel.upper()}] {mensaje}\n"
        try:
            with open(cls.LOG_FILE, "a", encoding="utf-8") as f:
                f.write(log_entry)
        except Exception as e:
            print(f"Error crítico al escribir en el log: {e}")


# ==========================================
# 2. EXCEPCIONES PERSONALIZADAS
# ==========================================
class SoftwareFJException(Exception):
    """Excepción base para los errores del sistema de Software FJ."""
 pass

class ClienteNoEncontradoException(SoftwareFJException):
    def __init__(self, mensaje="El cliente especificado no está registrado o sus datos son inválidos."):
        super().__init__(mensaje)

class ServicioNoDisponibleException(SoftwareFJException):
    def __init__(self, mensaje="El servicio solicitado no se encuentra disponible actualmente."):
        super().__init__(mensaje)

class ReservaInvalidaException(SoftwareFJException):
    def __init__(self, mensaje="Los datos de la reserva contienen inconsistencias o parámetros inválidos."):
        super().__init__(mensaje)
